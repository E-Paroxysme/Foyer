# Géré par Foyer. Notifications temporaires, en attendant la pastille.
# Position : en bas au centre, comme la future pastille.
anchor=bottom-center
margin=24
width=420
padding=14
border-size=2
border-radius=12
font=Inter 11
background-color=#111116ee
text-color=#f0ece6
border-color=#e8875a
default-timeout=6000
max-visible=3

[urgency=critical]
border-color=#e05d5d
default-timeout=0
