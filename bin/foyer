#!/usr/bin/env bash
# Commande principale de Foyer.
#   foyer install            installe tout (tous les modules, puis les migrations)
#   foyer update             met à jour le dépôt, relance tous les modules et les migrations
#   foyer update <module>    met à jour le dépôt et relance un seul module (ex. : foyer update vie-privee)
#   foyer modules            liste les modules disponibles
#   foyer groupes            liste les groupes de logiciels optionnels
#   foyer installer <groupe> installe un groupe optionnel (ex. : foyer installer si)
#   foyer version            affiche la version installée
set -euo pipefail
# Marqueurs internes de relance. Ils valent le numéro du processus qui les a posés :
# une valeur héritée d'un autre programme (terminal ouvert depuis le hub, etc.) ne
# correspond jamais au processus courant et est donc ignorée. On les retire aussitôt
# de l'environnement pour qu'aucun programme lancé par Foyer n'en hérite.
DEJA_RELANCE=""
[[ "${FOYER_RELANCE:-}" == "$$" ]] && DEJA_RELANCE=1
unset FOYER_RELANCE FOYER_RELAIS

FOYER_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export FOYER_DIR
# shellcheck source=../modules/commun.sh
source "$FOYER_DIR/modules/commun.sh"

lister_modules() {
  find "$FOYER_DIR/modules" -maxdepth 1 -name '[0-9][0-9]-*.sh' | sort
}

nom_module() { basename "$1" .sh | cut -d- -f2-; }

# Poids de chaque module dans la progression globale (le volume réel de travail).
declare -A POIDS=([depots]=10 [pilotes]=5 [paquets]=60 [vie-privee]=4 [bureau]=4 [services]=2 [instantanes]=15)
FAIT=0 TOTAL=0 RANG=0 NB=0

preparer_progression() {
  local f
  TOTAL=0; FAIT=0; RANG=0; NB=$#
  for f in "$@"; do TOTAL=$((TOTAL + ${POIDS[$(nom_module "$f")]:-5})); done
}

lancer_module() {
  local fichier="$1" nom
  nom="$(nom_module "$fichier")"
  RANG=$((RANG + 1))
  barre $((FAIT * 100 / TOTAL)) "Étape $RANG/$NB — $nom"
  etape "Module : $nom"
  # Chaque module s'exécute dans un sous-shell : une erreur s'arrête là,
  # avec un message clair, sans laisser d'état à moitié chargé.
  if ! bash "$fichier"; then
    erreur "Le module « $nom » a échoué. Journal : $FOYER_JOURNAL"
  fi
  FAIT=$((FAIT + ${POIDS[$nom]:-5}))
}

lancer_tous() {
  local liste
  mapfile -t liste < <(lister_modules)
  preparer_progression "${liste[@]}"
  for f in "${liste[@]}"; do lancer_module "$f"; done
  barre 100 "Terminé"
}

lancer_migrations() {
  local etat="$FOYER_ETAT/migrations-faites"
  touch "$etat"
  local m
  for m in $(find "$FOYER_DIR/migrations" -maxdepth 1 -name '*.sh' | sort); do
    local id
    id="$(basename "$m")"
    if ! grep -qxF "$id" "$etat"; then
      etape "Migration : $id"
      bash "$m" || erreur "La migration $id a échoué."
      echo "$id" >>"$etat"
    fi
  done
}

mettre_a_jour_depot() {
  [[ -d "$FOYER_DIR/.git" ]] || return 0
  info "Mise à jour du dépôt Foyer…"
  local branche
  branche="$(git -C "$FOYER_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  [[ "$branche" == "HEAD" ]] && branche=main
  if ! git -C "$FOYER_DIR" fetch --quiet origin "$branche"; then
    avertir "ÉCHEC : impossible de récupérer la nouvelle version (réseau ou GitHub). Rien n'a été mis à jour côté Foyer."
    return 0
  fi
  # Ce dossier n'appartient qu'à Foyer (tes réglages sont dans ~/.config) : on
  # l'aligne exactement sur la version publiée. Une modification locale ou un
  # fichier abîmé ne peut donc plus bloquer une mise à jour. Par prudence, les
  # modifications locales éventuelles sont sauvegardées dans le journal d'état.
  if ! git -C "$FOYER_DIR" diff --quiet HEAD 2>/dev/null; then
    local sauvegarde
    sauvegarde="$FOYER_ETAT/modifs-locales-$(date +%F-%H%M%S).diff"
    git -C "$FOYER_DIR" diff HEAD >"$sauvegarde" 2>/dev/null || true
    avertir "Modifications locales du dépôt remplacées (copie : $sauvegarde)"
  fi
  git -C "$FOYER_DIR" reset --quiet --hard "origin/$branche" \
    || avertir "Alignement du dépôt impossible, on continue avec la version locale."
  git -C "$FOYER_DIR" config core.fileMode false
}

# Contenu du relais /usr/local/bin/foyer. Il passe par « bash » (marche même sans
# droit d'exécution) et se répare tout seul si bin/foyer a été abîmé.
contenu_relais() {
  cat <<EOF
#!/bin/sh
# Relais Foyer (géré par Foyer, réécrit à chaque mise à jour)
F="$FOYER_DIR"
# Garde-fou : si le relais se rappelle lui-même, on s'arrête au lieu de boucler.
[ "\$FOYER_RELAIS" = "\$\$" ] && { echo "Foyer : boucle détectée, lance : bash \$F/bin/foyer update" >&2; exit 1; }
export FOYER_RELAIS=\$\$
if ! grep -q '^lancer_tous()' "\$F/bin/foyer" 2>/dev/null; then
  echo "Foyer : programme abîmé, réparation automatique…" >&2
  git -C "\$F" checkout -- bin/foyer 2>/dev/null \\
    || { git -C "\$F" fetch -q origin && git -C "\$F" reset -q --hard origin/main; }
fi
exec bash "\$F/bin/foyer" "\$@"
EOF
}

installer_commande() {
  # Rend « foyer » disponible partout via un petit script relais.
  # Jamais d'écriture « à travers » l'existant (une ancienne version était un lien
  # vers bin/foyer : écrire dedans écrasait bin/foyer). On supprime, puis on pose
  # un fichier neuf, et seulement si le contenu a changé.
  local cible=/usr/local/bin/foyer tmp
  tmp="$(mktemp)"
  contenu_relais >"$tmp"
  if [[ -L "$cible" ]] || ! cmp -s "$tmp" "$cible"; then
    sudo rm -f "$cible"
    sudo install -m 755 "$tmp" "$cible"
  fi
  rm -f "$tmp"
}

version_courte() {
  git -C "$FOYER_DIR" log -1 --format='Foyer %h du %cd' --date=format:'%d/%m/%Y %H:%M' 2>/dev/null \
    || echo "Foyer (version inconnue)"
}

cmd="${1:-aide}"
case "$cmd" in
  install)
    verifier_prerequis
    installer_commande
    lancer_tous
    lancer_migrations
    succes "Installation terminée. Redémarre l'ordinateur : sudo reboot"
    ;;
  update)
    verifier_prerequis
    if [[ -z "$DEJA_RELANCE" ]]; then
      mettre_a_jour_depot
      installer_commande
      # La commande foyer elle-même vient peut-être d'être mise à jour : on relance
      # la nouvelle version pour que tout le reste s'exécute avec le code à jour.
      export FOYER_RELANCE=$$   # « exec » garde le même numéro de processus
      exec bash "$FOYER_DIR/bin/foyer" "$@"
    fi
    if [[ -n "${2:-}" ]]; then
      f="$(lister_modules | grep -E "/[0-9]{2}-$2\.sh$" || true)"
      [[ -n "$f" ]] || erreur "Module inconnu : $2 (voir : foyer modules)"
      preparer_progression "$f"
      lancer_module "$f"
    else
      lancer_tous
    fi
    lancer_migrations
    succes "Mise à jour terminée — $(version_courte)"
    ;;
  version|-v|--version)
    version_courte
    ;;
  modules)
    for f in $(lister_modules); do echo "  $(nom_module "$f")"; done
    ;;
  groupes)
    choix="$FOYER_CONFIG/foyer/groupes"
    for g in "$FOYER_DIR"/paquets/groupes/*.txt; do
      nom="$(basename "$g" .txt)"
      etat="  "; grep -qxF "$nom" "$choix" 2>/dev/null && etat="✔ "
      printf '  %s%-12s %s\n' "$etat" "$nom" "$(description_groupe "$g")"
    done
    ;;
  installer)
    [[ -n "${2:-}" ]] || erreur "Précise un groupe (voir : foyer groupes)"
    [[ -f "$FOYER_DIR/paquets/groupes/$2.txt" ]] || erreur "Groupe inconnu : $2 (voir : foyer groupes)"
    verifier_prerequis
    etape "Groupe : $(description_groupe "$FOYER_DIR/paquets/groupes/$2.txt")"
    installer_liste "$FOYER_DIR/paquets/groupes/$2.txt"
    mkdir -p "$FOYER_CONFIG/foyer"
    grep -qxF "$2" "$FOYER_CONFIG/foyer/groupes" 2>/dev/null || echo "$2" >>"$FOYER_CONFIG/foyer/groupes"
    succes "Groupe « $2 » installé."
    ;;
  aide|-h|--help)
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
  *)
    printf 'Commande inconnue : « %s »\n\n' "$cmd" >&2
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
