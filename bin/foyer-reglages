#!/usr/bin/env python3
# Géré par Foyer. Ce que la vue Réglages du hub lit et modifie. Chaque commande
# répond en JSON (lecture) ou applique un réglage, puis s'arrête.
#
# Les réglages de Foyer sont rangés dans ~/.config/foyer/reglages.json ; les
# fichiers produits (veille, souris, écran) sont réécrits à partir de lui.
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
FOYER = CONFIG / "foyer"
HYPR = CONFIG / "hypr"
REGLAGES = FOYER / "reglages.json"
FOYER_DIR = Path(__file__).resolve().parent.parent
THEME_PERSO = FOYER / "theme.json"

DEFAUTS = {
    "veille": {"ecran": 300, "verrou": 600, "suspension": 1200},
    "entrees": {"sensibilite": 0.0, "defilementNaturel": True, "tapClic": True, "vitesseRepetition": 35,
                "dispositions": [{"code": "fr", "variante": ""}]},
    "ecran": {"echelle": 1.0},
    "ecrans": {},
    "nuit": {"mode": "non", "temperature": 4500, "debut": "21:00", "fin": "07:00"},
    "avion": False,
    "compte": {"nom": ""},
}


def sortie(cmd, delai=8):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=delai).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def lancer(cmd, delai=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=delai).returncode
    except (OSError, subprocess.TimeoutExpired):
        return 1


def fond(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def lire():
    try:
        r = json.loads(REGLAGES.read_text())
    except (OSError, ValueError):
        r = {}
    for cle, val in DEFAUTS.items():
        if not isinstance(val, dict):
            r.setdefault(cle, val)
            continue
        r.setdefault(cle, {})
        for k, v in val.items():
            r[cle].setdefault(k, v)
    return r


def ecrire(r):
    FOYER.mkdir(parents=True, exist_ok=True)
    tmp = REGLAGES.with_suffix(".tmp")
    tmp.write_text(json.dumps(r, ensure_ascii=False, indent=2) + "\n")
    tmp.replace(REGLAGES)


def ecrire_fichier(chemin, texte):
    chemin.parent.mkdir(parents=True, exist_ok=True)
    if chemin.exists() and chemin.read_text() == texte:
        return False
    tmp = chemin.with_name("." + chemin.name + ".tmp")
    tmp.write_text(texte)
    tmp.replace(chemin)
    return True


def theme_en_fond():
    fond([str(FOYER_DIR / "bin/foyer"), "theme"])


# --- Lecture générale -----------------------------------------------------------
def nom_compte():
    r = lire()
    if r["compte"].get("nom"):
        return r["compte"]["nom"]
    utilisateur = os.environ.get("USER") or sortie(["id", "-un"]).strip()
    gecos = sortie(["getent", "passwd", utilisateur]).split(":")
    return (gecos[4].split(",")[0] if len(gecos) > 4 and gecos[4] else utilisateur)


def cmd_etat(_a):
    r = lire()
    utilisateur = os.environ.get("USER") or sortie(["id", "-un"]).strip()
    try:
        perso = json.loads(THEME_PERSO.read_text())
    except (OSError, ValueError):
        perso = {}
    themes = []
    for f in sorted((FOYER_DIR / "defaults/themes").glob("*.json")):
        try:
            d = json.loads(f.read_text())
        except ValueError:
            continue
        themes.append({"id": f.stem, "nom": d.get("description", f.stem).split(" ")[0].rstrip(":"),
                       "accent": d.get("couleurs", {}).get("accent", "#e8875a"),
                       "panneau": d.get("couleurs", {}).get("panneau", "#1c1714")})
    du = shutil.disk_usage(str(HOME))
    infos = {}
    for cle, fichier in (("modele", "product_version"), ("fabricant", "sys_vendor"), ("produit", "product_name")):
        try:
            infos[cle] = Path("/sys/class/dmi/id/" + fichier).read_text().strip()
        except OSError:
            infos[cle] = ""
    cpu = ""
    try:
        m = re.search(r"model name\s*:\s*(.+)", Path("/proc/cpuinfo").read_text())
        cpu = re.sub(r"\s+", " ", m.group(1)) if m else ""
    except OSError:
        pass
    memoire = 0
    try:
        m = re.search(r"MemTotal:\s*(\d+)", Path("/proc/meminfo").read_text())
        memoire = int(m.group(1)) * 1024 if m else 0
    except OSError:
        pass
    td = dict(l.split("=", 1) for l in sortie(["timedatectl", "show"]).splitlines() if "=" in l)
    profil = sortie(["powerprofilesctl", "get"]).strip()
    defauts = {
        "navigateur": sortie(["xdg-settings", "get", "default-web-browser"]).strip(),
        "courriel": sortie(["xdg-mime", "query", "default", "x-scheme-handler/mailto"]).strip(),
        "fichiers": sortie(["xdg-mime", "query", "default", "inode/directory"]).strip(),
        "pdf": sortie(["xdg-mime", "query", "default", "application/pdf"]).strip(),
        "images": sortie(["xdg-mime", "query", "default", "image/png"]).strip(),
        "musique": sortie(["xdg-mime", "query", "default", "audio/mpeg"]).strip(),
        "video": sortie(["xdg-mime", "query", "default", "video/mp4"]).strip(),
    }
    gs = lambda schema, cle: sortie(["gsettings", "get", schema, cle]).strip()
    version = sortie(["git", "-C", str(FOYER_DIR), "describe", "--tags", "--always"]).strip()
    print(json.dumps({
        "compte": {"nom": nom_compte(), "utilisateur": utilisateur, "photo": (HOME / ".face").exists(),
                   "photoChemin": str(HOME / ".face")},
        "reglages": r,
        "theme": {"base": perso.get("base", "braise"), "perso": perso, "liste": themes,
                  "eco": (FOYER / "profil-graphique").exists() and (FOYER / "profil-graphique").read_text().strip() == "eco"},
        "energie": profil,
        "disque": {"utilise": du.used, "total": du.total},
        "pc": {"modele": infos["modele"] or infos["produit"], "fabricant": infos["fabricant"], "processeur": cpu, "memoire": memoire,
               "noyau": os.uname().release},
        "heure": {"auto": td.get("NTP") == "yes", "fuseau": td.get("Timezone", "")},
        "defauts": defauts,
        "confidentialite": {"recents": gs("org.gnome.desktop.privacy", "remember-recent-files") != "false",
                            "corbeille": gs("org.gnome.desktop.privacy", "remove-old-trash-files") == "true"},
        "foyer": {"version": version},
    }, ensure_ascii=False))


# --- Wi-Fi (NetworkManager) -------------------------------------------------------
def champs_nmcli(ligne):
    return [c.replace("\\:", ":") for c in re.split(r"(?<!\\):", ligne)]


def cmd_wifi(a):
    if a.args and a.args[0] in ("on", "off"):
        sys.exit(lancer(["nmcli", "radio", "wifi", a.args[0]]))
    actif = sortie(["nmcli", "-t", "-f", "WIFI", "radio"]).strip() == "enabled"
    reseaux, vus = [], set()
    if actif:
        brut = sortie(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "auto"], 15)
        connus = {champs_nmcli(l)[0] for l in sortie(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"]).splitlines()
                  if l.endswith(":802-11-wireless")}
        for l in brut.splitlines():
            c = champs_nmcli(l)
            if len(c) < 4 or not c[1] or c[1] in vus:
                continue
            vus.add(c[1])
            reseaux.append({"nom": c[1], "connecte": c[0] == "*", "force": int(c[2] or 0),
                            "protege": c[3] not in ("", "--"), "connu": c[1] in connus})
        reseaux.sort(key=lambda w: (not w["connecte"], -w["force"]))
    print(json.dumps({"actif": actif, "reseaux": reseaux}, ensure_ascii=False))


def cmd_wifi_connecter(a):
    ssid = a.args[0]
    mdp = sys.stdin.readline().rstrip("\n") if not sys.stdin.isatty() else ""
    connus = [champs_nmcli(l)[0] for l in sortie(["nmcli", "-t", "-f", "NAME", "connection", "show"]).splitlines()]
    if ssid in connus and not mdp:
        code = lancer(["nmcli", "connection", "up", "id", ssid])
    else:
        cmd = ["nmcli", "device", "wifi", "connect", ssid] + (["password", mdp] if mdp else [])
        code = lancer(cmd, 45)
    sys.exit(code)


def cmd_wifi_oublier(a):
    sys.exit(lancer(["nmcli", "connection", "delete", "id", a.args[0]]))


# --- Bluetooth (bluetoothctl) -----------------------------------------------------
def cmd_bt(a):
    if a.args and a.args[0] in ("on", "off"):
        sys.exit(lancer(["bluetoothctl", "power", a.args[0]]))
    if a.args and a.args[0] == "chercher":
        lancer(["bluetoothctl", "--timeout", "8", "scan", "on"], 12)
    infos = sortie(["bluetoothctl", "show"])
    actif = "Powered: yes" in infos
    appareils = []
    appaires = {l.split(" ", 2)[1] for l in sortie(["bluetoothctl", "devices", "Paired"]).splitlines() if l.startswith("Device ")}
    for l in sortie(["bluetoothctl", "devices"]).splitlines():
        p = l.split(" ", 2)
        if len(p) < 3 or p[0] != "Device":
            continue
        mac, nom = p[1], p[2]
        if nom.replace("-", ":") == mac:
            continue  # appareil sans nom : bruit de la recherche
        info = sortie(["bluetoothctl", "info", mac])
        icone = re.search(r"Icon:\s*(\S+)", info)
        batterie = re.search(r"Battery Percentage:.*\((\d+)\)", info)
        appareils.append({"mac": mac, "nom": nom, "appaire": mac in appaires, "connecte": "Connected: yes" in info,
                          "type": icone.group(1) if icone else "", "batterie": int(batterie.group(1)) if batterie else -1})
    appareils.sort(key=lambda d: (not d["appaire"], not d["connecte"], d["nom"].lower()))
    print(json.dumps({"actif": actif, "appareils": appareils}, ensure_ascii=False))


def cmd_bt_action(a):
    action, mac = a.args[0], a.args[1]
    if action == "appairer":
        code = lancer(["bluetoothctl", "--timeout", "15", "pair", mac], 20)
        lancer(["bluetoothctl", "trust", mac])
        code = lancer(["bluetoothctl", "--timeout", "10", "connect", mac], 15) if code == 0 else code
    elif action == "connecter":
        code = lancer(["bluetoothctl", "--timeout", "10", "connect", mac], 15)
    elif action == "deconnecter":
        code = lancer(["bluetoothctl", "disconnect", mac])
    elif action == "oublier":
        code = lancer(["bluetoothctl", "remove", mac])
    else:
        code = 2
    sys.exit(code)


# --- Écran, énergie, veille ----------------------------------------------------------
def cmd_luminosite(a):
    if a.args:
        sys.exit(lancer(["brightnessctl", "-q", "set", f"{int(a.args[0])}%"]))
    m = sortie(["brightnessctl", "-m"]).strip().split(",")
    print(json.dumps({"disponible": len(m) > 3, "valeur": int(m[3].rstrip("%")) if len(m) > 3 else 100}))


def ecrire_veille(r):
    v = r["veille"]
    lignes = ["# Géré par Foyer : produit par les Réglages du hub (ne pas modifier).",
              "general {", "    lock_cmd = pidof hyprlock || hyprlock",
              "    before_sleep_cmd = loginctl lock-session", "    after_sleep_cmd = hyprctl dispatch dpms on", "}"]
    if v["ecran"]:
        lignes += ["", "listener {", f"    timeout = {int(v['ecran'])}", "    on-timeout = hyprctl dispatch dpms off",
                   "    on-resume = hyprctl dispatch dpms on", "}"]
    if v["verrou"]:
        lignes += ["", "listener {", f"    timeout = {int(v['verrou'])}", "    on-timeout = loginctl lock-session", "}"]
    if v["suspension"]:
        lignes += ["", "listener {", f"    timeout = {int(v['suspension'])}", "    on-timeout = systemctl suspend", "}"]
    return ecrire_fichier(HYPR / "hypridle.conf", "\n".join(lignes) + "\n")


def relancer_hypridle():
    lancer(["pkill", "-x", "hypridle"])
    fond(["uwsm", "app", "-s", "b", "-t", "service", "--", "hypridle"])


def cmd_veille(a):
    r = lire()
    if a.args:
        ecran, verrou, suspension = (int(x) for x in a.args[:3])
        r["veille"] = {"ecran": ecran, "verrou": verrou, "suspension": suspension}
        ecrire(r)
    if ecrire_veille(r) and not a.sans_relance:
        relancer_hypridle()


def cmd_energie(a):
    sys.exit(lancer(["powerprofilesctl", "set", a.args[0]]))


def ecrire_entrees(r):
    e, ec = r["entrees"], r["ecran"]
    disp = e.get("dispositions") or [{"code": "fr", "variante": ""}]
    lignes = ["-- Géré par Foyer : produit par les Réglages du hub (ne pas modifier).", "hl.config({", "\tinput = {",
              f'\t\tkb_layout = "{",".join(d["code"] for d in disp)}",',
              f'\t\tkb_variant = "{",".join(d.get("variante", "") for d in disp)}",',
              # Plusieurs dispositions : Alt + Maj pour passer de l'une à l'autre.
              f'\t\tkb_options = "{"grp:alt_shift_toggle" if len(disp) > 1 else ""}",',
              f"\t\tsensitivity = {float(e['sensibilite']):.2f},",
              f"\t\trepeat_rate = {int(e['vitesseRepetition'])},",
              "\t\ttouchpad = {",
              f"\t\t\tnatural_scroll = {str(bool(e['defilementNaturel'])).lower()},",
              f"\t\t\ttap_to_click = {str(bool(e['tapClic'])).lower()},",
              "\t\t},", "\t},", "})",
              "-- Écrans : réglage général, puis un réglage par écran choisi dans le hub.",
              "hl.monitor({", '\toutput = "",', '\tmode = "preferred",', '\tposition = "auto",', f'\tscale = "{float(ec["echelle"]):g}",', "})"]
    for nom, m in sorted(r.get("ecrans", {}).items()):
        lignes += ["hl.monitor({", f'\toutput = "{nom}",']
        if m.get("actif") is False:
            lignes += ["\tdisabled = true,", "})"]
            continue
        lignes += [f'\tmode = "{m.get("mode") or "preferred"}",', f'\tposition = "{m.get("position") or "auto"}",',
                   f'\tscale = "{float(m.get("echelle") or ec["echelle"]):g}",', f'\ttransform = {int(m.get("rotation", 0))},']
        if m.get("recopie"):
            lignes.append(f'\tmirror = "{m["recopie"]}",')
        lignes.append("})")
    return ecrire_fichier(HYPR / "reglages.lua", "\n".join(lignes) + "\n")


def cmd_entrees(a):
    r = lire()
    for paire in a.args:
        cle, _, val = paire.partition("=")
        if cle in ("sensibilite",):
            r["entrees"][cle] = max(-1.0, min(1.0, float(val)))
        elif cle in ("defilementNaturel", "tapClic"):
            r["entrees"][cle] = val in ("1", "true", "oui")
        elif cle == "vitesseRepetition":
            r["entrees"][cle] = int(val)
        elif cle == "echelle":
            r["ecran"]["echelle"] = float(val)
        elif cle == "dispositions":
            # fr,us(intl) → [{code: fr}, {code: us, variante: intl}]
            liste = []
            for d in filter(None, val.split(",")):
                m = re.match(r"([a-z]+)(?:\(([\w-]+)\))?$", d.strip())
                if m:
                    liste.append({"code": m.group(1), "variante": m.group(2) or ""})
            r["entrees"]["dispositions"] = liste or [{"code": "fr", "variante": ""}]
    ecrire(r)
    if ecrire_entrees(r) and not a.sans_relance:
        lancer(["hyprctl", "reload"])


# --- Compte, photo, fond -----------------------------------------------------------
def magick():
    return shutil.which("magick") or shutil.which("convert")


def cmd_nom(a):
    r = lire()
    r["compte"]["nom"] = " ".join(a.args).strip()
    ecrire(r)
    theme_en_fond()


def cmd_photo(a):
    m = magick()
    if not m:
        sys.exit("ImageMagick absent")
    code = lancer([m, a.args[0] + "[0]", "-auto-orient", "-resize", "512x512^", "-gravity", "center", "-extent", "512x512",
                   "png:" + str(HOME / ".face")])
    if code == 0:
        theme_en_fond()
    sys.exit(code)


def cmd_fond(a):
    cible = FOYER / "fond.jpg"
    if a.args and a.args[0] == "theme":
        # Revenir au fond dessiné aux couleurs du thème
        (FOYER / "fond.auto").write_text("")
        theme_en_fond()
        return
    (FOYER / "fond.auto").unlink(missing_ok=True)
    m = magick()
    code = lancer([m, a.args[0] + "[0]", "-auto-orient", "-quality", "92", str(cible)]) if m else 1
    if code != 0:
        shutil.copyfile(a.args[0], cible)
    lancer(["pkill", "-x", "swaybg"])
    fond(["uwsm", "app", "-s", "b", "--", "swaybg", "-m", "fill", "-i", str(cible)])
    theme_en_fond()


def cmd_images(_a):
    dossiers = [HOME / "Images", HOME / "Pictures", HOME / "Bureau", HOME / "Desktop", HOME / "Téléchargements",
                HOME / "Downloads", FOYER_DIR / "defaults/fonds", Path("/usr/share/backgrounds")]
    trouves = []
    for d in dossiers:
        if not d.is_dir():
            continue
        for f in sorted(d.rglob("*"), key=lambda p: -p.stat().st_mtime if p.exists() else 0):
            if f.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp") and f.is_file():
                trouves.append(str(f))
                if len(trouves) >= 24:
                    break
        if len(trouves) >= 24:
            break
    print(json.dumps(trouves, ensure_ascii=False))


# --- Thème -------------------------------------------------------------------------
def cmd_theme(a):
    """foyer-reglages theme base=ocean couleurs.accent=#4f8fe0 transparence.panneau=0.8 eco=1 …"""
    try:
        perso = json.loads(THEME_PERSO.read_text())
    except (OSError, ValueError):
        perso = {}
    for paire in a.args:
        cle, _, val = paire.partition("=")
        if cle == "eco":
            (FOYER / "profil-graphique").write_text(("eco" if val in ("1", "true") else "normal") + "\n")
            continue
        if cle == "reinitialiser":
            perso = {k: v for k, v in perso.items() if k == "description"}
            perso["base"] = "braise"
            continue
        if cle == "base":
            # Changer de thème efface les retouches de couleur faites sur l'ancien.
            perso.pop("couleurs", None)
        try:
            valeur = json.loads(val)
        except ValueError:
            valeur = val
        o = perso
        morceaux = cle.split(".")
        for m in morceaux[:-1]:
            o = o.setdefault(m, {})
        if valeur is None:
            o.pop(morceaux[-1], None)
        else:
            o[morceaux[-1]] = valeur
    FOYER.mkdir(parents=True, exist_ok=True)
    THEME_PERSO.write_text(json.dumps(perso, ensure_ascii=False, indent=2) + "\n")
    theme_en_fond()


# --- Disposition du hub (~/.config/foyer/disposition.json, relu tout seul par le hub)
def cmd_disposition(a):
    f = FOYER / "disposition.json"
    try:
        d = json.loads(f.read_text())
    except (OSError, ValueError):
        d = json.loads((FOYER_DIR / "defaults/foyer/disposition.json").read_text())
    for paire in a.args:
        cle, _, val = paire.partition("=")
        if cle.startswith("widgets."):
            d.setdefault("widgets", {})[cle.split(".", 1)[1]] = val in ("1", "true")
        elif cle in ("entete", "bureaux", "visualiseur"):
            d[cle] = val
    FOYER.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")


# --- Applications par défaut, confidentialité, heure ----------------------------------
def cmd_defaut(a):
    genre, appli = a.args[0], a.args[1]
    types = {
        "courriel": ["x-scheme-handler/mailto"],
        "fichiers": ["inode/directory"],
        "pdf": ["application/pdf"],
        "images": ["image/png", "image/jpeg", "image/webp", "image/gif"],
        "musique": ["audio/mpeg", "audio/flac", "audio/ogg", "audio/x-wav"],
        "video": ["video/mp4", "video/x-matroska", "video/webm"],
    }
    if genre == "navigateur":
        sys.exit(lancer(["xdg-settings", "set", "default-web-browser", appli]))
    sys.exit(max(lancer(["xdg-mime", "default", appli, t]) for t in types.get(genre, [])))


def cmd_confidentialite(a):
    for paire in a.args:
        cle, _, val = paire.partition("=")
        oui = "true" if val in ("1", "true") else "false"
        if cle == "recents":
            lancer(["gsettings", "set", "org.gnome.desktop.privacy", "remember-recent-files", oui])
            if oui == "false":
                (HOME / ".local/share/recently-used.xbel").unlink(missing_ok=True)
        elif cle == "corbeille":
            lancer(["gsettings", "set", "org.gnome.desktop.privacy", "remove-old-trash-files", oui])
        elif cle == "presse-papier":
            lancer(["cliphist", "wipe"])


def cmd_heure(a):
    sys.exit(lancer(["timedatectl", "set-ntp", "true" if a.args[0] in ("1", "true") else "false"]))


# --- Mode avion ------------------------------------------------------------------------
def cmd_avion(a):
    r = lire()
    oui = a.args[0] in ("1", "on", "true")
    r["avion"] = oui
    ecrire(r)
    lancer(["nmcli", "radio", "all", "off" if oui else "on"])
    lancer(["bluetoothctl", "power", "off" if oui else "on"])


# --- Écrans ------------------------------------------------------------------------------
def cmd_ecrans(_a):
    try:
        brut = json.loads(sortie(["hyprctl", "monitors", "all", "-j"]) or "[]")
    except ValueError:
        brut = []
    r = lire()
    res = []
    for m in brut:
        modes = []
        for md in m.get("availableModes", []):
            mm = re.match(r"(\d+)x(\d+)@([\d.]+)Hz", md)
            if mm:
                cle = f"{mm.group(1)}x{mm.group(2)}@{round(float(mm.group(3)))}"
                if cle not in modes:
                    modes.append(cle)
        res.append({
            "nom": m.get("name", ""), "description": (m.get("make", "") + " " + m.get("model", "")).strip() or m.get("description", ""),
            "actif": not m.get("disabled", False), "largeur": m.get("width", 0), "hauteur": m.get("height", 0),
            "frequence": round(m.get("refreshRate", 0)), "echelle": m.get("scale", 1), "rotation": m.get("transform", 0),
            "x": m.get("x", 0), "y": m.get("y", 0), "modes": modes[:12], "recopie": m.get("mirrorOf", "none") not in ("none", ""),
            "interne": m.get("name", "").startswith(("eDP", "LVDS", "DSI")),
            "reglage": r["ecrans"].get(m.get("name", ""), {}),
        })
    print(json.dumps(res, ensure_ascii=False))


def cmd_ecran(a):
    """foyer-reglages ecran HDMI-A-1 mode=1920x1080@60 echelle=1 rotation=0 position=auto-right recopie=eDP-1 actif=1"""
    r = lire()
    nom = a.args[0]
    m = r["ecrans"].setdefault(nom, {})
    for paire in a.args[1:]:
        cle, _, val = paire.partition("=")
        if cle == "actif":
            m["actif"] = val in ("1", "true")
        elif cle in ("echelle",):
            m[cle] = float(val)
        elif cle == "rotation":
            m[cle] = int(val)
        elif cle in ("mode", "position", "recopie"):
            m[cle] = val
        elif cle == "oublier":
            r["ecrans"].pop(nom, None)
    ecrire(r)
    if ecrire_entrees(r) and not a.sans_relance:
        lancer(["hyprctl", "reload"])


# --- Éclairage nocturne (hyprsunset) -------------------------------------------------
def ecrire_nuit(r):
    n = r["nuit"]
    t = int(n.get("temperature", 4500))
    lignes = ["# Géré par Foyer : produit par les Réglages du hub (ne pas modifier)."]
    if n.get("mode") == "toujours":
        lignes += ["profile {", "    time = 00:00", f"    temperature = {t}", "}"]
    elif n.get("mode") == "soir":
        lignes += ["profile {", f"    time = {n.get('fin', '07:00')}", "    identity = true", "}",
                   "profile {", f"    time = {n.get('debut', '21:00')}", f"    temperature = {t}", "}"]
    else:
        lignes += ["profile {", "    time = 00:00", "    identity = true", "}"]
    return ecrire_fichier(HYPR / "hyprsunset.conf", "\n".join(lignes) + "\n")


def cmd_nuit(a):
    r = lire()
    for paire in a.args:
        cle, _, val = paire.partition("=")
        if cle == "temperature":
            r["nuit"][cle] = max(2500, min(6500, int(val)))
        elif cle in ("mode", "debut", "fin"):
            r["nuit"][cle] = val
    ecrire(r)
    ecrire_nuit(r)
    if not a.sans_relance:
        lancer(["pkill", "-x", "hyprsunset"])
        fond(["uwsm", "app", "-s", "b", "--", "hyprsunset"])


# --- Applications au démarrage (XDG autostart) ------------------------------------------
def dossiers_applis():
    data = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    base = [Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))] + [Path(d) for d in data]
    base += [HOME / ".local/share/flatpak/exports/share", Path("/var/lib/flatpak/exports/share")]
    return [d / "applications" for d in base]


def cmd_demarrage(a):
    auto = CONFIG / "autostart"
    if a.args and a.args[0] in ("ajouter", "retirer"):
        ident = a.args[1].removesuffix(".desktop")
        cible = auto / (ident + ".desktop")
        if a.args[0] == "retirer":
            cible.unlink(missing_ok=True)
            return
        for d in dossiers_applis():
            src = d / (ident + ".desktop")
            if src.exists():
                auto.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(src, cible)
                return
        sys.exit("Application introuvable : " + ident)
    res = []
    if auto.is_dir():
        for f in sorted(auto.glob("*.desktop")):
            txt = f.read_text(errors="ignore")
            nom = re.search(r"^Name(?:\[fr\])?=(.+)$", txt, re.M)
            cache = re.search(r"^(Hidden|X-GNOME-Autostart-enabled)=(true|false)$", txt, re.M)
            res.append({"id": f.stem, "nom": nom.group(1) if nom else f.stem,
                        "actif": not (cache and ((cache.group(1) == "Hidden" and cache.group(2) == "true") or (cache.group(1) != "Hidden" and cache.group(2) == "false")))})
    print(json.dumps(res, ensure_ascii=False))


# --- Énergie : capot et limite de charge (demandent le mot de passe) ----------------------
def batterie_seuil():
    for b in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        f = b / "charge_control_end_threshold"
        if f.exists():
            return f
    return None


def cmd_energie_etat(_a):
    capot = "veille"
    try:
        txt = Path("/etc/systemd/logind.conf.d/foyer-capot.conf").read_text()
        m = re.search(r"HandleLidSwitch=(\w+)", txt)
        capot = {"suspend": "veille", "lock": "verrou", "ignore": "rien"}.get(m.group(1), "veille") if m else "veille"
    except OSError:
        pass
    seuil = batterie_seuil()
    valeur = None
    if seuil:
        try:
            valeur = int(seuil.read_text().strip())
        except (OSError, ValueError):
            pass
    print(json.dumps({"capot": capot, "limiteDisponible": seuil is not None, "limite": valeur}))


def cmd_capot(a):
    action = {"veille": "suspend", "verrou": "lock", "rien": "ignore"}[a.args[0]]
    contenu = f"# Géré par Foyer (Réglages du hub).\n[Login]\nHandleLidSwitch={action}\nHandleLidSwitchExternalPower={action}\n"
    script = ("mkdir -p /etc/systemd/logind.conf.d && "
              f"printf '%s' '{contenu}' > /etc/systemd/logind.conf.d/foyer-capot.conf && "
              "systemctl kill -s HUP systemd-logind")
    sys.exit(lancer(["pkexec", "sh", "-c", script], 120))


def cmd_limite_charge(a):
    seuil = batterie_seuil()
    if not seuil:
        sys.exit("Limite de charge non disponible sur cet ordinateur.")
    v = int(a.args[0])
    # Appliquée tout de suite, et à chaque démarrage par une règle udev.
    regle = f'SUBSYSTEM=="power_supply", KERNEL=="{seuil.parent.name}", ATTR{{charge_control_end_threshold}}="{v}"'
    script = (f"echo {v} > {seuil} && printf '%s\\n' '{regle}' > /etc/udev/rules.d/90-foyer-batterie.rules")
    sys.exit(lancer(["pkexec", "sh", "-c", script], 120))


# --- Instantanés Btrfs (snapper) ---------------------------------------------------------
def cmd_instantanes(a):
    if a.args and a.args[0] == "creer":
        sys.exit(lancer(["snapper", "-c", "root", "create", "-d", "Foyer : instantané manuel"], 120))
    if not shutil.which("snapper"):
        print(json.dumps({"disponible": False, "liste": []}))
        return
    try:
        d = json.loads(sortie(["snapper", "--jsonout", "-c", "root", "list"], 20) or "{}")
    except ValueError:
        d = {}
    liste = [{"numero": x.get("number"), "date": x.get("date", ""), "description": x.get("description", ""),
              "type": x.get("type", ""), "important": (x.get("userdata") or {}).get("important") == "yes"}
             for x in d.get("root", []) if x.get("number")]
    print(json.dumps({"disponible": "root" in d, "liste": liste[::-1][:20]}, ensure_ascii=False))


# --- Appliquer tout (après une mise à jour) -------------------------------------------
def cmd_appliquer(_a):
    r = lire()
    ecrire_veille(r)
    ecrire_entrees(r)
    ecrire_nuit(r)


def main():
    import argparse
    p = argparse.ArgumentParser(prog="foyer-reglages")
    p.add_argument("commande")
    p.add_argument("args", nargs="*")
    p.add_argument("--sans-relance", action="store_true")
    a = p.parse_args()
    table = {
        "etat": cmd_etat, "wifi": cmd_wifi, "wifi-connecter": cmd_wifi_connecter, "wifi-oublier": cmd_wifi_oublier,
        "bt": cmd_bt, "bt-action": cmd_bt_action, "luminosite": cmd_luminosite, "veille": cmd_veille,
        "energie": cmd_energie, "entrees": cmd_entrees, "nom": cmd_nom, "photo": cmd_photo, "fond": cmd_fond,
        "images": cmd_images, "theme": cmd_theme, "defaut": cmd_defaut, "confidentialite": cmd_confidentialite,
        "heure": cmd_heure, "appliquer": cmd_appliquer, "avion": cmd_avion, "ecrans": cmd_ecrans, "ecran": cmd_ecran,
        "nuit": cmd_nuit, "demarrage": cmd_demarrage, "energie-etat": cmd_energie_etat, "capot": cmd_capot,
        "limite-charge": cmd_limite_charge, "instantanes": cmd_instantanes, "disposition": cmd_disposition,
    }
    if a.commande not in table:
        sys.exit("Commande inconnue : " + a.commande)
    table[a.commande](a)


if __name__ == "__main__":
    main()
