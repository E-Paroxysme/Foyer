#!/usr/bin/env bash
# Géré par Foyer. Lance le hub (Quickshell) avec les variables de
# ~/.config/foyer/hub.env (une par ligne, NOM=valeur) : par exemple
# QT_QUICK_BACKEND=software dans une machine virtuelle sans accélération 3D.
fichier="${XDG_CONFIG_HOME:-$HOME/.config}/foyer/hub.env"
if [[ -f "$fichier" ]]; then
  while IFS='=' read -r nom valeur; do
    [[ "$nom" =~ ^[A-Z_][A-Z0-9_]*$ ]] && export "$nom=$valeur"
  done <"$fichier"
fi
# Thème d'icônes : sans lui, Quickshell ne trouve pas les icônes des applications
# (il n'y a pas de bureau GNOME/KDE pour le lui indiquer).
if [[ -z "${QS_ICON_THEME:-}" ]]; then
  theme="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")"
  export QS_ICON_THEME="${theme:-hicolor}"
fi
exec qs -c foyer "$@"
